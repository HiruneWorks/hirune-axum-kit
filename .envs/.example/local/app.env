APP_NAME="Hirune Axum Kit"
APP_ENV=development
PUBLIC_URL=http://localhost:3000/
ALLOWED_ORIGINS=http://localhost:3000
# Only trust proxies that overwrite X-Forwarded-For with one client IP.
TRUSTED_PROXY_IPS=
BIND_ADDRESS=127.0.0.1:3000
DATABASE_URL=postgres://kit:local-development-only@localhost:54329/kit
MIGRATION_DATABASE_URL=postgres://kit:local-development-only@localhost:54329/kit
DATABASE_MAX_CONNECTIONS=10
# Run `just init` to generate independent local secrets.
ACTIVE_SECRET_KEY=local-v1
SECRET_KEYS='{}'
RATE_LIMIT_KEY=
SMTP_HOST=localhost
SMTP_PORT=10259
SMTP_STARTTLS=false
# Optional PEM root, used only with STARTTLS.
# SMTP_CA_CERTIFICATE=/run/certificates/smtp-ca.pem
MAIL_FROM="Hirune <noreply@example.test>"
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
PASSWORD_CONCURRENCY=4
AUTH_IDENTITY_LIMIT_PER_MINUTE=10
AUTH_CLIENT_LIMIT_PER_MINUTE=60
WORKER_CONCURRENCY=4
JOB_LEASE_SECONDS=30
JOB_EXECUTION_SECONDS=120
WORKER_DRAIN_SECONDS=35
SUCCEEDED_JOB_RETENTION_DAYS=30
FAILED_JOB_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
MAINTENANCE_INTERVAL_SECONDS=300
RUST_LOG=info,sqlx=off,sea_orm=off,reqwest=off,hyper=off
# OIDC and Sentry are optional; leave unset unless configured.
# JSON array of named OIDC providers; see docs/runtime.md for a multi-provider example.
OIDC_PROVIDERS=[]
# SENTRY_DSN=
# SENTRY_SAMPLE_RATE=0.05
# Optional originals and filename search: start `just infra-up-files`, set these,
# then run `just manage initialize-integrations` after migrations.
# S3_ENDPOINT=http://localhost:8339/
# S3_BUCKET=kit-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=kit-local-access
# S3_SECRET_KEY=kit-local-development-secret-only
# S3_ALLOW_HTTP=true
# MEILISEARCH_URL=http://localhost:7709/
# MEILISEARCH_API_KEY=kit-local-meilisearch-key-development-only
# MEILISEARCH_ALLOW_HTTP=true
# MEILISEARCH_INDEX=files
FILE_MAX_BYTES=104857600
FILE_ORGANIZATION_QUOTA_BYTES=1073741824
FILE_ORGANIZATION_LIMIT=10000
FILE_PENDING_LIMIT=100
FILE_RESERVATIONS_PER_MINUTE=30
FILE_TOMBSTONE_DAYS=30
FILE_TRANSFER_CONCURRENCY=4
FILE_TRANSFER_SECONDS=300
FILE_TRANSFER_IDLE_SECONDS=30
