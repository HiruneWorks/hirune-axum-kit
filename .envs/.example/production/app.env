APP_NAME="Hirune Axum Kit"
APP_ENV=production
# Optional private file store and derived filename/post/profile search.
# S3_ENDPOINT=https://s3.example.com/
# S3_BUCKET=application-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# MEILISEARCH_URL=https://search.example.com/
# MEILISEARCH_API_KEY=
# MEILISEARCH_INDEX=files
# MEILISEARCH_POSTS_INDEX=posts
# MEILISEARCH_PROFILES_INDEX=profiles
FILE_MAX_BYTES=104857600
FILE_ORGANIZATION_QUOTA_BYTES=1073741824
FILE_ORGANIZATION_LIMIT=10000
FILE_PENDING_LIMIT=100
FILE_RESERVATIONS_PER_MINUTE=30
FILE_TOMBSTONE_DAYS=30
FILE_TRANSFER_CONCURRENCY=4
FILE_TRANSFER_SECONDS=300
FILE_TRANSFER_IDLE_SECONDS=30
PUBLIC_URL=https://app.example.com/
ALLOWED_ORIGINS=https://app.example.com
TRUSTED_PROXY_IPS=
BIND_ADDRESS=0.0.0.0:3000
DATABASE_URL=postgres://runtime:REPLACE_ME@database.example.com:5432/app?sslmode=require
DATABASE_MAX_CONNECTIONS=10
ACTIVE_SECRET_KEY=production-v1
SECRET_KEYS='{}'
RATE_LIMIT_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
# Optional PEM root for a private SMTP certificate authority.
# SMTP_CA_CERTIFICATE=/run/certificates/smtp-ca.pem
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="Hirune <noreply@example.com>"
SESSION_IDLE_SECONDS=1209600
SESSION_ABSOLUTE_SECONDS=7776000
PASSWORD_CONCURRENCY=4
AUTH_IDENTITY_LIMIT_PER_MINUTE=10
AUTH_CLIENT_LIMIT_PER_MINUTE=60
WORKER_CONCURRENCY=4
# Delay after an empty queue lookup; ready jobs do not wait between claims.
WORKER_POLL_MILLISECONDS=250
JOB_LEASE_SECONDS=30
JOB_EXECUTION_SECONDS=120
WORKER_DRAIN_SECONDS=35
SUCCEEDED_JOB_RETENTION_DAYS=30
FAILED_JOB_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
API_USAGE_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90
MAINTENANCE_INTERVAL_SECONDS=300
# Optional FCM delivery; the inbox works without provider credentials.
FCM_ENABLED=false
# FCM_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# JSON array of named OIDC providers; client secrets belong in secret management.
OIDC_PROVIDERS=[]
RUST_LOG=info,sqlx=off,sea_orm=off,reqwest=off,hyper=off
