set working-directory := ".."
set dotenv-load := false
set positional-arguments := true
set windows-shell := ["sh", "-cu"]

default:
    @just --justfile deploy/justfile --list

# Render and validate one environment without displaying secrets or contacting its cluster.
check environment:
    cargo xtask deploy-k3s check "$1"

# Migrate once, then roll out. Use drain only for an offline upgrade.
up environment mode="rolling":
    cargo xtask deploy-k3s up "$1" "$2"

# Stop runtime Pods and keep namespace, settings, secrets, and external data.
down environment:
    cargo xtask deploy-k3s down "$1"

status environment:
    cargo xtask deploy-k3s status "$1"

logs environment deployment="hirune-api":
    cargo xtask deploy-k3s logs "$1" "$2"

manage environment +arguments:
    cargo xtask deploy-k3s manage "$@"

cleanup environment:
    cargo xtask deploy-k3s cleanup "$1"

# Run on the selected data host. Application deployments remain Kubernetes operations.
data-check environment:
    cargo xtask data check "$1"

data-up environment:
    cargo xtask data up "$1"

data-down environment:
    cargo xtask data down "$1"

data-status environment:
    cargo xtask data status "$1"

data-logs environment service="postgres":
    cargo xtask data logs "$1" "$2"

backup environment type="incr":
    cargo xtask data backup "$1" "$2"

backup-check environment:
    cargo xtask data backup-check "$1"

backup-info environment:
    cargo xtask data backup-info "$1"

# Restore to a new volume. This does not replace the live database.
restore environment label target="":
    if [ -n "$3" ]; then cargo xtask data restore "$1" "$2" "$3"; else cargo xtask data restore "$1" "$2"; fi

# Continue WAL validation in a retained recovery volume, without restoring files again.
restore-resume environment label:
    cargo xtask data restore-resume "$1" "$2"
