[Unit]
Description=Hirune database and file maintenance
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/hirune/deploy
ExecStart=/usr/bin/docker compose --env-file production.env -f compose.yml run --rm maintenance
ExecStart=/usr/bin/docker compose --env-file production.env -f compose.yml run --rm manage repair-search
TimeoutStartSec=240
